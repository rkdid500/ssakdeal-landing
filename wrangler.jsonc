{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ssakdeal",
  // TanStack Start emits the SSR Worker here (`npm run build`).
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Static files in dist/client are served first; everything else hits SSR.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // Consultation requests. Create once with `npx wrangler d1 create ssakdeal-db`
  // and paste the printed database_id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ssakdeal-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
